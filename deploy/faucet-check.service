[Unit]
# Runs deploy/faucet-check.sh: fails, and tells a person once, when an asset the faucet pays as
# leaves holds fewer payouts than its warning level, before it runs out.
Description=Sequentia faucet: payouts left check
Documentation=https://github.com/ConcatenaLabs/sequentia-faucet
After=network-online.target sequentia-faucet.service

[Service]
Type=oneshot
TimeoutStartSec=120
ExecStart=/root/sequentia/sequentia-faucet/deploy/faucet-check.sh
Environment=FAUCET_URL=http://127.0.0.1:9960
# The last verdict, so a change is what alerts, not every run.
StateDirectory=sequentia-faucet-check
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
